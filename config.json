{
  "paths": {
    "dataset_dir": "data/raw_brown_dwarf_pilot",
    "processed_dir": "data/processed_brown_dwarf_pilot",
    "model_dir": "models/brown_dwarf_pilot",
    "overwrite_dataset": false
  },
  "solver": {
    "M": 42,
    "dt_seconds": 240.0,
    "default_time_days": 0.05,
    "starttime_index": 2,
    "forcing_mode": "unforced"
  },
  "geometry": {
    "flip_latitude_to_north_south": true,
    "roll_longitude_to_0_2pi": true
  },
  "sampling": {
    "seed": 42,
    "n_sims": 8,
    "generation_workers": 1,
    "burn_in_days": 0.0,
    "saved_checkpoint_interval_days": 0.005555555555555556,
    "fixed_transition_steps": 8,
    "pairs_per_sim": 4,
    "pair_sampling_policy": "uniform_pairs",
    "live_transition_tolerance_fraction": 0.0,
    "parameters": [
      { "name": "a_m", "dist": "fixed", "value": 71492000.0 },
      { "name": "omega_rad_s", "dist": "fixed", "value": 0.0003490658503988659 },
      { "name": "Phibar", "dist": "fixed", "value": 300000.0 },
      { "name": "DPhieq", "dist": "fixed", "value": 0.0 },
      { "name": "taurad_hours", "dist": "fixed", "value": 10.0 },
      { "name": "taudrag_hours", "dist": "fixed", "value": 6.0 },
      { "name": "g_m_s2", "dist": "fixed", "value": 300.0 }
    ]
  },
  "normalization": {
    "state": {
      "field_transforms": {
        "Phi": "signed_log1p",
        "U": "signed_log1p",
        "V": "signed_log1p",
        "eta": "signed_log1p",
        "delta": "signed_log1p"
      },
      "zscore_eps": 1e-8,
      "log10_eps": 1e-30,
      "signed_log1p_scale": 1.0
    },
    "params": {
      "mode": "zscore",
      "eps": 1e-8
    }
  },
  "model": {
    "grid": "legendre-gauss",
    "grid_internal": "legendre-gauss",
    "scale_factor": 2,
    "embed_dim": 64,
    "num_layers": 2,
    "encoder_layers": 2,
    "activation_function": "gelu",
    "use_mlp": true,
    "mlp_ratio": 2.0,
    "drop_rate": 0.0,
    "drop_path_rate": 0.0,
    "normalization_layer": "instance_norm",
    "hard_thresholding_fraction": 1.0,
    "residual_prediction": true,
    "include_coord_channels": true,
    "pos_embed": "spectral",
    "bias": false
  },
  "training": {
    "seed": 42,
    "device": "auto",
    "amp_mode": "none",
    "deterministic": false,
    "epochs": 5,
    "batch_size": 4,
    "num_workers": 0,
    "shuffle": true,
    "preload_to_gpu": false,
    "pair_iteration_mode": "resample_from_saved_sequences",
    "learning_rate": 1e-3,
    "weight_decay": 1e-5,
    "grad_clip_norm": 32.0,
    "val_fraction": 0.25,
    "test_fraction": 0.25,
    "split_seed": 42,
    "scheduler": {
      "type": "cosine_warmup",
      "warmup_epochs": 1,
      "min_lr": 1e-6
    }
  }
}
